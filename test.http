@base = http://localhost:4004
@service = {{base}}/student-service
@studentId = arjun
@auth = Basic c2FtZWVyOnNhbWVlcg==

### ==========================================
### 1. METADATA
### ==========================================

GET {{service}}/$metadata
Authorization: {{auth}}


### ==========================================
### 2. READ STUDENTS
### ==========================================

### Get all students
GET {{service}}/Students
Authorization: {{auth}}

### Get selected fields
GET {{service}}/Students?$select=ID,name,email,department,status,bpNumber
Authorization: {{auth}}

### Get student by string ID
GET {{service}}/Students('{{studentId}}')
Authorization: {{auth}}

### Filter CSE students
GET {{service}}/Students?$filter=department eq 'CSE'
Authorization: {{auth}}

### Find admitted students
GET {{service}}/Students?$filter=status eq 'admitted'
Authorization: {{auth}}


### ==========================================
### 3. CREATE STUDENT - ODATA CRUD
### ==========================================

POST {{service}}/Students
Authorization: {{auth}}
Content-Type: application/json

{
  "ID": "arjun",
  "name": "Arjun Das",
  "email": "arjun@example.com",
  "department": "CSE",
  "status": "applied",
  "age": 20,
  "bpNumber": "1000000001"
}


### ==========================================
### 4. UPDATE STUDENT - ODATA CRUD
### ==========================================

PATCH {{service}}/Students('{{studentId}}')
Authorization: {{auth}}
Content-Type: application/json

{
  "department": "ECE",
  "status": "admitted"
}


### ==========================================
### 5. DELETE STUDENT - ODATA CRUD
### ==========================================

DELETE {{service}}/Students('{{studentId}}')
Authorization: {{auth}}


### ==========================================
### 6. READ COURSES
### ==========================================

GET {{service}}/Courses
Authorization: {{auth}}

### Get a course by code
GET {{service}}/Courses('CAP101')
Authorization: {{auth}}


### ==========================================
### 7. CREATE COURSE
### ==========================================

POST {{service}}/Courses
Authorization: {{auth}}
Content-Type: application/json

{
  "code": "CAP101",
  "title": "SAP CAP Fundamentals",
  "credits": 3,
  "capacity": 100,
  "teacher": "Sameer"
}


### ==========================================
### 8. READ ENROLLMENTS
### ==========================================

GET {{service}}/Enrollments
Authorization: {{auth}}


### ==========================================
### 9. BOUND ACTION: changeDepartment
### ==========================================

POST {{service}}/Students('{{studentId}}')/StudentService.changeDepartment
Authorization: {{auth}}
Content-Type: application/json

{
  "department": "MBA"
}


### ==========================================
### 10. BOUND FUNCTION: getEnrolledCourses
### ==========================================

GET {{service}}/Students('{{studentId}}')/StudentService.getEnrolledCourses()
Authorization: {{auth}}


### ==========================================
### 11. BOUND ACTION: graduate
### ==========================================

POST {{service}}/Students('{{studentId}}')/StudentService.graduate
Authorization: {{auth}}
Content-Type: application/json

{}


### ==========================================
### 12. BOUND ACTION: deleteStudent
### ==========================================

POST {{service}}/Students('{{studentId}}')/StudentService.deleteStudent
Authorization: {{auth}}
Content-Type: application/json

{}


### ==========================================
### 13. UNBOUND FUNCTION: getTotalStudent
### ==========================================

GET {{service}}/getTotalStudent()
Authorization: {{auth}}


### ==========================================
### 14. UNBOUND ACTION: admitAllCSEApplicants
### ==========================================

POST {{service}}/admitAllCSEApplicants
Authorization: {{auth}}
Content-Type: application/json

{}


### ==========================================
### 15. UNBOUND ACTION: createStudent
### ==========================================

POST {{service}}/createStudent
Authorization: {{auth}}
Content-Type: application/json

{
  "name": "Priya Mishra",
  "email": "priya@example.com",
  "department": "CSE",
  "status": "applied",
  "ID": "priya",
  "bpNumber": "1000000002"
}


### ==========================================
### 16. UNBOUND ACTION: updateStudent
### ==========================================

POST {{service}}/updateStudent
Authorization: {{auth}}
Content-Type: application/json

{
  "studentId": "arjun",
  "name": "Arjun Das",
  "email": "arjun@example.com",
  "department": "ECE",
  "status": "admitted"
}

