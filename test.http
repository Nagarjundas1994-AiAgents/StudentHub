@base = http://localhost:4004/student-service

### ==========================================
### 1. SERVICE METADATA
### ==========================================
GET {{base}}/$metadata


### ==========================================
### 2. READ ALL STUDENTS
### ==========================================
GET {{base}}/Students

//get total number of students
###
GET {{base}}/getTotalStudent()


### ==========================================
### 3. READ ONE STUDENT
### ==========================================
GET {{base}}/Students(ID='arjun')


### ==========================================
### 4. CREATE A STUDENT
### ==========================================
POST {{base}}/Students
Content-Type: application/json

{
  "ID": "rahul",
  "name": "Rahul Das",
  "email": "rahul@example.com",
  "department": "CSE",
  "status": "applied"
}


### ==========================================
### 5. UPDATE A STUDENT
### ==========================================
PATCH {{base}}/Students(ID='rahul')
Content-Type: application/json

{
  "department": "ECE"
}


### ==========================================
### 6. BOUND ACTION: ADMIT ONE STUDENT
### ==========================================
POST {{base}}/Students(ID='arjun')/StudentService.admit
Content-Type: application/json

{}


### ==========================================
### 7. BOUND ACTION: CHANGE DEPARTMENT
### ==========================================
POST {{base}}/Students(ID='arjun')/StudentService.changeDepartment
Content-Type: application/json

{
  "department": "MEC"
}


### ==========================================
### 8. BOUND FUNCTION: COUNT ENROLLMENTS
### ==========================================
GET {{base}}/Students(ID='arjun')/StudentService.enrollmentCount()


### ==========================================
### 9. UNBOUND ACTION: ADMIT ALL CSE APPLICANTS
### ==========================================
POST {{base}}/admitAll
Content-Type: application/json

{
  "department": "CSE"
}


### ==========================================
### 10. UNBOUND ACTION: DELETE STUDENT
### ==========================================
POST {{base}}/deleteStudent()
Content-Type: application/json

{
  "ID": "rahul"
}


### ==========================================
### 11. UNBOUND FUNCTION: COUNT STUDENTS
### ==========================================
GET {{base}}/studentCount()


### ==========================================
### 12. UNBOUND FUNCTION: FIND STUDENTS BY DEPARTMENT
### ==========================================
GET {{base}}/studentsByDepartment(department='CSE')


### ==========================================
### 13. STANDARD CRUD: DELETE STUDENT
### ==========================================
DELETE {{base}}/Students(ID='rahul')


### ==========================================
### 14. READ ALL COURSES
### ==========================================
GET {{base}}/Courses


### ==========================================
### 15. CREATE A COURSE
### ==========================================
POST {{base}}/Courses
Content-Type: application/json

{
  "code": "CS501",
  "title": "Advanced SAP CAP",
  "credits": 4,
  "capacity": 30,
  "teacher": "Dr. Priya Nair"
}


### ==========================================
### 16. UPDATE A COURSE
### ==========================================
PATCH {{base}}/Courses(code='CS101')
Content-Type: application/json

{
  "capacity": 70
}


### ==========================================
### 17. DELETE A COURSE
### ==========================================
DELETE {{base}}/Courses(code='CS501')


### ==========================================
### 18. READ ALL ENROLLMENTS
### ==========================================
GET {{base}}/Enrollments


### ==========================================
### 19. CREATE AN ENROLLMENT
### ==========================================
POST {{base}}/Enrollments
Content-Type: application/json

{
  "student_ID": "arjun",
  "course_code": "CS101"
}


### ==========================================
### 20. DELETE AN ENROLLMENT
### Replace the UUID with an existing enrollment ID
### ==========================================
DELETE {{base}}/Enrollments(ID=11111111-1111-4111-8111-000000000001)


###

DELETE {{base}}/deleteStudent(ID='arjun')


### =========================================
### getEnrolledCourses for the student
### =========================================
GET {{base}}/Students(ID='rahul')/StudentService.getEnrolledCourses()



###
DELETE {{base}}/Students('arjun')

###

POST {{base}}/Students('arjun')/StudentService.deleteStudent
Content-Type: application/json

{}