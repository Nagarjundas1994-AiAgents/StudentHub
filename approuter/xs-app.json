{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/student-service/(.*)$",
      "target": "/student-service/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/students/(.*)$",
      "target": "$1",
      "localDir": "resources/students",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/index.html$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/assets/(.*)$",
      "target": "$1",
      "localDir": "resources/assets",
      "authenticationType": "none"
    }
  ]
}
