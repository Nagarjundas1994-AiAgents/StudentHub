<mvc:View controllerName="studenthub.ui.controller.Main"
  xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" height="100%">
  <App>
    <Page title="StudentHub" showNavButton="true" navButtonPress=".onHome">
      <headerContent>
        <Button text="Log out" icon="sap-icon://log" press=".onLogout"/>
      </headerContent>
      <IconTabBar expandable="false" class="sapUiResponsiveContentPadding" select=".onTabSelect">
        <items>
  
          <IconTabFilter text="Students" icon="sap-icon://group">
            <Table id="studentTable" items="{/Students}" mode="SingleSelectLeft"
                   selectionChange=".onSelect" growing="true" sticky="ColumnHeaders,HeaderToolbar">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="Students"/>
                  <ToolbarSpacer/>
                  <Text id="total" text=""/>
                  <Button text="Total" icon="sap-icon://sum" press=".onTotal"/>
                  <Button text="Admit all CSE applicants" icon="sap-icon://accept" press=".onAdmitCSE"/>
                  <Button text="Create" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
                  <Button id="btnEdit" text="Edit" icon="sap-icon://edit" enabled="false" press=".onEdit"/>
                  <Button id="btnDept" text="Change department" icon="sap-icon://offsite-work" enabled="false" press=".onChangeDept"/>
                  <Button id="btnCourses" text="Enrolled courses" icon="sap-icon://course-book" enabled="false" press=".onCourses"/>
                  <Button id="btnGrad" text="Graduate" icon="sap-icon://education" enabled="false" press=".onGraduate"/>
                  <Button id="btnBP" text="Business partner" icon="sap-icon://customer" enabled="false" press=".onStudentBP"/>
                  <Button id="btnLink" text="Link BP" icon="sap-icon://chain-link" enabled="false" press=".onLinkBP"/>
                  <Button id="btnDel" text="Delete" icon="sap-icon://delete" type="Reject" enabled="false" press=".onDelete"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="ID"/></Column>
                <Column><Text text="Name"/></Column>
                <Column><Text text="Email"/></Column>
                <Column><Text text="Department"/></Column>
                <Column><Text text="Status"/></Column>
                <Column><Text text="BP Number"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{ID}"/>
                  <Text text="{name}"/>
                  <Text text="{email}"/>
                  <Text text="{department}"/>
                  <ObjectStatus text="{status}" state="{= ${status} === 'admitted' ? 'Success' : ${status} === 'graduated' ? 'Information' : 'None'}"/>
                  <Text text="{bpNumber}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
  
          <IconTabFilter text="Courses" icon="sap-icon://course-book">
            <Table items="{/Courses}" growing="true">
              <columns>
                <Column><Text text="Code"/></Column>
                <Column><Text text="Title"/></Column>
                <Column><Text text="Credits"/></Column>
                <Column><Text text="Capacity"/></Column>
                <Column><Text text="Teacher"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{code}"/><Text text="{title}"/><Text text="{credits}"/>
                  <Text text="{capacity}"/><Text text="{teacher}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
  
          <IconTabFilter text="Enrollments" icon="sap-icon://list">
            <Table items="{/Enrollments}" growing="true">
              <columns>
                <Column><Text text="Student"/></Column>
                <Column><Text text="Course"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{student_ID}"/><Text text="{course_code}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- live data from SAP S/4HANA (S4BusinessPartnerService) -->
          <IconTabFilter text="Business Partners" icon="sap-icon://customer">
            <Table id="bpTable" items="{s4>/BusinessPartners}" mode="SingleSelectLeft"
                   selectionChange=".onSelectBP" growing="true" sticky="ColumnHeaders,HeaderToolbar">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="S/4HANA Business Partners"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" placeholder="Search by name" search=".onSearchBP"/>
                  <Text id="bpTotal" text=""/>
                  <Button text="Count" icon="sap-icon://sum" press=".onCountBP"/>
                  <Button text="Customers by country" icon="sap-icon://world" press=".onCustomersByCountry"/>
                  <Button id="btnAddr" text="Addresses" icon="sap-icon://addresses" enabled="false" press=".onAddresses"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="BP Number"/></Column>
                <Column><Text text="Name"/></Column>
                <Column><Text text="Category"/></Column>
                <Column><Text text="Customer"/></Column>
                <Column><Text text="Supplier"/></Column>
                <Column><Text text="Created on"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{s4>BusinessPartner}"/>
                  <Text text="{s4>BusinessPartnerFullName}"/>
                  <Text text="{= ${s4>BusinessPartnerCategory} === '1' ? 'Person' : ${s4>BusinessPartnerCategory} === '2' ? 'Organization' : 'Group'}"/>
                  <Text text="{s4>Customer}"/>
                  <Text text="{s4>Supplier}"/>
                  <Text text="{s4>CreationDate}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
  
          <!-- live data from The Dog API (DogService) -->
          <IconTabFilter key="dogs" text="Dog Details" icon="sap-icon://heart">
            <Table id="dogTable" items="{dog>/Dogs}" mode="SingleSelectLeft"
                   selectionChange=".onSelectDog" growing="true" sticky="ColumnHeaders,HeaderToolbar">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="Dogs"/>
                  <ToolbarSpacer/>
                  <Button text="Refresh" icon="sap-icon://refresh" press=".onRefreshDogs"/>
                  <Button text="Create" icon="sap-icon://add" type="Emphasized" press=".onCreateDog"/>
                  <Button id="btnDogEdit" text="Edit" icon="sap-icon://edit" enabled="false" press=".onEditDog"/>
                  <Button id="btnDogDel" text="Delete" icon="sap-icon://delete" type="Reject" enabled="false" press=".onDeleteDog"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="Photo"/></Column>
                <Column><Text text="Name"/></Column>
                <Column><Text text="Breed"/></Column>
                <Column><Text text="Species"/></Column>
                <Column><Text text="Gender"/></Column>
                <Column><Text text="Neutered"/></Column>
                <Column><Text text="Date of birth"/></Column>
                <Column><Text text="Country"/></Column>
                <Column><Text text="BCS"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Avatar src="{dog>imageURL}" displayShape="Circle" customDisplaySize="2.5rem" customFontSize="1rem"/>
                  <Text text="{dog>name}"/>
                  <Text text="{= ${dog>breedName} || ${dog>breedID}}"/>
                  <Text text="{dog>speciesID}"/>
                  <Text text="{dog>gender}"/>
                  <Text text="{dog>neuterStatus}"/>
                  <Text text="{dog>dateOfBirth}"/>
                  <Text text="{dog>country}"/>
                  <Text text="{dog>bodyConditionScore}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
  
        </items>
      </IconTabBar>
    </Page>
  </App>
</mvc:View>
