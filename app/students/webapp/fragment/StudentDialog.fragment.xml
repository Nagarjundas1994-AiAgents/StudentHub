<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog title="{form>/title}" contentWidth="26rem">
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
      <Label text="ID" required="true"/>
      <Input value="{form>/ID}" enabled="{form>/isNew}" maxLength="20"/>
      <Label text="Name" required="true"/>
      <Input value="{form>/name}" maxLength="100"/>
      <Label text="Email" required="true"/>
      <Input value="{form>/email}" type="Email" maxLength="120"/>
      <Label text="Department"/>
      <Select selectedKey="{form>/department}">
        <core:Item key="" text=""/><core:Item key="CSE" text="CSE"/>
        <core:Item key="ECE" text="ECE"/><core:Item key="MBA" text="MBA"/>
      </Select>
      <Label text="Status"/>
      <Select selectedKey="{form>/status}">
        <core:Item key="applied" text="applied"/><core:Item key="admitted" text="admitted"/><core:Item key="graduated" text="graduated"/>
      </Select>
      <Label text="BP Number"/>
      <Input value="{form>/bpNumber}" maxLength="10"/>
    </f:SimpleForm>
    <beginButton><Button text="Save" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="Cancel" press=".onCancel"/></endButton>
  </Dialog>
</core:FragmentDefinition>
